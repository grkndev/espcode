# --- Faz 4: redis-jobs / ide-builder ---
REDIS_JOBS_PASSWORD=              # openssl rand -base64 32

# --- Faz 5: ide-api (henüz kullanılmıyor) ---
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE=

# --- Faz 6: Postgres + GitHub OAuth ---
PG_PASSWORD=                       # openssl rand -base64 32
SESSION_SECRET=                    # openssl rand -base64 48
# github.com/settings/developers → New OAuth App (veya bir GitHub App'in
# "Identifying and authorizing users" bölümü de aynı akışla çalışır)
# GitHub localhost + portu kabul ediyor — port'a yalnızca literal
# "localhost"/"127.0.0.1" için izin veriyor (başka bir host, ör. localtest.me,
# + port "enter valid URI" ile reddediliyor, denendi). ngrok/localtest.me'ye
# GEREK YOK ve KULLANMA: frontend (localhost:3010) ve API (localhost:3001)
# böyle aynı site sayılıyor (SameSite portu saymaz), tarayıcının 3. taraf
# çerez engeli (Brave Shields, Chrome Privacy Sandbox) devreye girmiyor.
# ngrok'la denendiğinde SameSite=None + Secure ile bile çerez cross-site
# fetch'e hiç eklenmedi — üçüncü taraf çerez engeli CORS/cookie ayarlarıyla
# aşılamaz, tek çözüm frontend+API'yi aynı site yapmak.
# Homepage URL: http://localhost:3010
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Faz 6.1: GitHub App (proje bazlı GitHub depolama, §3.1) ---
# github.com/settings/apps/new → Repository permissions: Contents (Read &
# write), Metadata (Read-only). Webhook kapalı. Setup URL:
# http://localhost:3001/api/github/callback ("Redirect on update" açık).
# Private key indirilip yerelde secrets/ altına konur (dosya adı GitHub'ın
# verdiği isimle kalabilir) — .env'e DEĞİL (docker-compose.yml tüm secrets/'ı
# /run/secrets olarak salt-okunur bağlar).
GITHUB_APP_ID=
GITHUB_APP_SLUG=                  # App ayarları sayfasındaki URL'in son parçası
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/<indirilen-dosya-adı>.pem
